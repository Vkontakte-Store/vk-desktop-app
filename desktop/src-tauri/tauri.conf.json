{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vkontakte Store",
  "mainBinaryName": "vkontakte-store",
  "version": "0.1.0",
  "identifier": "store.vkontakte.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Business",
    "shortDescription": "Админка товаров ВКонтакте",
    "longDescription": "Окно ВКонтакте Store открывает сайт. Вход VK ID и сессия — те же, что в браузере.",
    "homepage": "https://dev.vkontakte.store",
    "linux": {
      "deb": {
        "desktopTemplate": "vkontakte-store.desktop"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
